<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password - KejaHub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Inter',sans-serif; }
    body { min-height:100vh; display:flex; }
    .left {
      flex:1;
      background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                  url('/images/reg.jpg') center/cover no-repeat;
      display:flex; flex-direction:column; justify-content:flex-end;
      padding:48px; color:white;
    }
    .left h1 { font-size:36px; font-weight:700; margin-bottom:12px; line-height:1.2; }
    .left p { font-size:15px; opacity:0.85; line-height:1.6; max-width:380px; }
    .right {
      flex:1; background:white;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      padding:56px 48px;
    }
    .form-panel { width:100%; max-width:480px; }
    .logo { font-size:22px; font-weight:700; color:#1B4332; margin-bottom:32px; }
    .logo span { color:#ff6f00; }
    h2 { font-size:26px; font-weight:700; color:#1a1a2e; margin-bottom:6px; }
    .subtitle { font-size:14px; color:#888; margin-bottom:28px; }
    .error { background:#fdecea; color:#c62828; padding:12px 14px; border-radius:8px; font-size:13px; margin-bottom:16px; }
    .error a { color:#c62828; font-weight:600; }
    label { display:block; font-size:13px; font-weight:500; color:#444; margin-bottom:5px; margin-top:16px; }
    input {
      width:100%; padding:12px 14px; border:1.5px solid #e0e0e0;
      border-radius:8px; font-size:14px; transition:border-color .2s;
    }
    input:focus { outline:none; border-color:#1B4332; }
    .btn {
      width:100%; padding:13px; background:#1B4332; color:white;
      border:none; border-radius:8px; font-size:15px; font-weight:600;
      cursor:pointer; margin-top:24px; transition:background .2s;
    }
    .btn:hover { background:#2D6A4F; }
    .hint { font-size:12px; color:#999; margin-top:4px; }
    .bottom { text-align:center; margin-top:20px; font-size:13px; color:#888; }
    .bottom a { color:#1B4332; text-decoration:none; font-weight:500; }
    .pwd-wrap { position:relative; }
    .pwd-wrap input { padding-right:42px; }
    .pwd-eye { position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#aaa; padding:4px; line-height:0; }
    .pwd-eye:hover { color:#1B4332; }
    @media(max-width:768px) {
      .left { display:none; }
      .right { padding:40px 24px; }
    }
  </style>
</head>
<body>
  <div class="left">
    <h1>Set a New Password</h1>
    <p>Choose a strong password for your KejaHub account. You'll be redirected to sign in after resetting.</p>
  </div>
  <div class="right">
    <div class="form-panel">
      <a href="/home" style="text-decoration:none"><div class="logo">Keja<span>Hub</span></div></a>
      <h2>Reset Password</h2>

      <% if (!valid) { %>
        <p class="subtitle">This link is no longer valid</p>
        <div class="error">
          <%= error %>
          <br><br><a href="/forgot-password">← Request a new reset link</a>
        </div>
      <% } else { %>
        <p class="subtitle">Enter and confirm your new password</p>
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form method="POST" action="/reset-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="token" value="<%= token %>">
          <label>New Password</label>
          <div class="pwd-wrap">
            <input type="password" name="new_password" id="new_password"
              placeholder="At least 8 characters" required minlength="8">
            <button type="button" class="pwd-eye" data-toggle-password aria-label="Show password">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <p class="hint">Minimum 8 characters</p>
          <label>Confirm New Password</label>
          <div class="pwd-wrap">
            <input type="password" name="confirm_password" id="confirm_password"
              placeholder="Repeat your new password" required>
            <button type="button" class="pwd-eye" data-toggle-password aria-label="Show password">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <button type="submit" class="btn">Set New Password</button>
        </form>
      <% } %>

      <div class="bottom"><a href="/login">← Back to Sign In</a></div>
    </div>
  </div>
  <script src="/js/password-toggle.js"></script>
</body>
</html>
