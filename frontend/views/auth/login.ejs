<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In - KejaHub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Inter',sans-serif; }
    body { min-height:100vh; display:flex; }
    .left {
      flex:1;
      background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                  url('/images/reg.jpg') center/cover no-repeat;
      display:flex;
      flex-direction:column;
      justify-content:flex-end;
      padding:48px;
      color:white;
    }
    .left h1 { font-size:36px; font-weight:700; margin-bottom:12px; line-height:1.2; }
    .left p { font-size:15px; opacity:0.85; line-height:1.6; max-width:380px; }
    .right {
      width:480px;
      background:white;
      display:flex;
      flex-direction:column;
      justify-content:center;
      padding:56px 48px;
    }
    .logo { font-size:22px; font-weight:700; color:#1565c0; margin-bottom:32px; }
    .logo span { color:#ff6f00; }
    h2 { font-size:26px; font-weight:700; color:#1a1a2e; margin-bottom:6px; }
    .subtitle { font-size:14px; color:#888; margin-bottom:28px; }
    .error { background:#fdecea; color:#c62828; padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:16px; }
    label { display:block; font-size:13px; font-weight:500; color:#444; margin-bottom:5px; margin-top:16px; }
    input {
      width:100%; padding:12px 14px; border:1.5px solid #e0e0e0;
      border-radius:8px; font-size:14px; transition:border-color .2s;
    }
    input:focus { outline:none; border-color:#1565c0; }
    .btn {
      width:100%; padding:13px; background:#1565c0; color:white;
      border:none; border-radius:8px; font-size:15px; font-weight:600;
      cursor:pointer; margin-top:24px; transition:background .2s;
    }
    .btn:hover { background:#0d47a1; }
    .bottom { text-align:center; margin-top:20px; font-size:13px; color:#888; }
    .bottom a { color:#1565c0; text-decoration:none; font-weight:500; }
    @media(max-width:768px) {
      .left { display:none; }
      .right { width:100%; padding:40px 24px; }
    }
  </style>
</head>
<body>
  <div class="left">
    <h1>Find Your Perfect Student Home</h1>
    <p>Affordable housing near your campus. Browse verified listings and connect with landlords easily.</p>
  </div>
  <div class="right">
    <div class="logo">Keja<span>Hub</span></div>
    <h2>Welcome Back</h2>
    <p class="subtitle">Sign in to your account to continue</p>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" autocomplete="off">
      <label>Email Address</label>
      <input type="email" name="email" placeholder="Enter your email" required autocomplete="new-password">
      <label>Password</label>
      <input type="password" name="password" placeholder="Enter your password" required autocomplete="new-password">
      <button type="submit" class="btn">Sign In</button>
    </form>
    <div class="bottom">Don't have an account? <a href="/register">Register Here</a></div>
  </div>
</body>
</html>