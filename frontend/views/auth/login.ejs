<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In | KejaHub</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
    :root {
      --forest:  #1B4332;
      --moss:    #2D6A4F;
      --leaf:    #52B788;
      --earth:   #C97D3A;
      --ink:     #1A1A1A;
      --slate:   #3D4F47;
      --quiet:   #7A9088;
      --border:  #D4E6DB;
      --danger:  #C62828;
      --success: #2E7D32;
      --cream:   #FFFDF5;
    }

    body { min-height: 100vh; display: flex; }

    .left {
      flex: 1;
      background:
        linear-gradient(160deg, rgba(27,67,50,0.88) 0%, rgba(27,67,50,0.65) 55%, rgba(0,0,0,0.28) 100%),
        url('/images/reg.jpg') center/cover no-repeat;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 52px;
      color: white;
    }
    .left-eyebrow {
      font-size: 11px; font-weight: 600; letter-spacing: 1.8px;
      text-transform: uppercase; color: rgba(82,183,136,0.9); margin-bottom: 14px;
    }
    .left h1 {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: 38px; font-weight: 400;
      line-height: 1.18; margin-bottom: 14px;
    }
    .left p { font-size: 15px; opacity: 0.72; line-height: 1.66; max-width: 380px; }

    .right {
      width: 460px;
      background: var(--cream);
      display: flex; flex-direction: column; justify-content: center;
      padding: 56px 48px;
    }

    .logo {
      font-size: 20px; font-weight: 700; color: var(--forest);
      text-decoration: none; display: block; margin-bottom: 36px;
    }
    .logo span { color: var(--earth); }

    h2 {
      font-family: 'DM Serif Display', Georgia, serif;
      font-size: 30px; font-weight: 400; color: var(--ink); margin-bottom: 6px;
    }
    .subtitle { font-size: 14px; color: var(--quiet); margin-bottom: 28px; }

    .error {
      background: #FDECEA; color: var(--danger);
      padding: 10px 14px; border-radius: 8px;
      font-size: 13px; margin-bottom: 16px;
      border-left: 3px solid var(--danger);
    }

    label { display: block; font-size: 13px; font-weight: 500; color: var(--slate); margin-bottom: 5px; margin-top: 16px; }

    input {
      width: 100%; padding: 11px 14px;
      border: 1.5px solid var(--border);
      border-radius: 8px; font-size: 14px;
      color: var(--ink); background: white;
      font-family: 'Inter', sans-serif;
      transition: border-color .2s, box-shadow .2s;
    }
    input:focus { outline: none; border-color: var(--leaf); box-shadow: 0 0 0 3px rgba(82,183,136,0.14); }
    input.field-invalid { border-color: var(--danger) !important; }
    input.field-valid   { border-color: var(--success) !important; }
    .field-error { display: block; font-size: 12px; color: var(--danger); margin-top: 3px; min-height: 16px; }

    .btn {
      width: 100%; padding: 13px;
      background: var(--forest); color: white;
      border: none; border-radius: 8px;
      font-size: 15px; font-weight: 600;
      cursor: pointer; margin-top: 24px;
      font-family: 'Inter', sans-serif;
      transition: background .2s;
    }
    .btn:hover { background: var(--moss); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .bottom { text-align: center; margin-top: 18px; font-size: 13px; color: var(--quiet); }
    .bottom a { color: var(--forest); text-decoration: none; font-weight: 500; }
    .bottom a:hover { text-decoration: underline; }

    .pwd-wrap { position: relative; }
    .pwd-wrap input { padding-right: 42px; }
    .pwd-eye {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: var(--quiet); padding: 4px; line-height: 0;
    }
    .pwd-eye:hover { color: var(--forest); }

    @media (max-width: 768px) {
      .left { display: none; }
      .right { width: 100%; padding: 40px 24px; }
    }
  </style>
</head>
<body>
  <div class="left">
    <p class="left-eyebrow">KejaHub · Kenya</p>
    <h1>Find your perfect student home</h1>
    <p>Affordable housing near your campus. Browse verified listings and connect with landlords easily.</p>
  </div>

  <div class="right">
    <a href="/home" class="logo">Keja<span>Hub</span></a>
    <h2>Welcome back</h2>
    <p class="subtitle">Sign in to your account to continue</p>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login" autocomplete="off" data-validate-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <label>Email address</label>
      <input type="email" name="email" placeholder="you@example.com" autocomplete="new-password"
        data-required="Email is required"
        data-email="Please enter a valid email address">
      <span class="field-error"></span>

      <label>Password</label>
      <div class="pwd-wrap">
        <input type="password" name="password" placeholder="Your password" autocomplete="new-password"
          data-required="Password is required">
        <button type="button" class="pwd-eye" onclick="togglePwd(this)" aria-label="Show password">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
      <span class="field-error"></span>

      <button type="submit" class="btn">Sign in</button>
    </form>

    <div class="bottom"><a href="/forgot-password">Forgot your password?</a></div>
    <div class="bottom" style="margin-top:10px">Don't have an account? <a href="/register">Register here</a></div>
  </div>

  <script src="/js/validation.js"></script>
  <script>
    var EYE = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
    var EYE_OFF = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
    function togglePwd(btn) {
      var input = btn.previousElementSibling;
      var hidden = input.type === 'password';
      input.type = hidden ? 'text' : 'password';
      btn.innerHTML = hidden ? EYE_OFF : EYE;
      btn.setAttribute('aria-label', hidden ? 'Hide password' : 'Show password');
    }
  </script>
  <script>sessionStorage.clear(); localStorage.clear();</script>
</body>
</html>
