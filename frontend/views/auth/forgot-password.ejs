<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password - KejaHub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin:0; padding:0; box-sizing:border-box; font-family:'Inter',sans-serif; }
    body { min-height:100vh; display:flex; }
    .left {
      flex:1;
      background: linear-gradient(rgba(0,0,0,0.45), rgba(0,0,0,0.45)),
                  url('/images/reg.jpg') center/cover no-repeat;
      display:flex; flex-direction:column; justify-content:flex-end;
      padding:48px; color:white;
    }
    .left h1 { font-size:36px; font-weight:700; margin-bottom:12px; line-height:1.2; }
    .left p { font-size:15px; opacity:0.85; line-height:1.6; max-width:380px; }
    .right {
      flex:1; background:white;
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      padding:56px 48px;
    }
    .form-panel { width:100%; max-width:480px; }
    .logo { font-size:22px; font-weight:700; color:#1B4332; margin-bottom:32px; }
    .logo span { color:#C97D3A; }
    h2 { font-size:26px; font-weight:700; color:#1a1a2e; margin-bottom:6px; }
    .subtitle { font-size:14px; color:#888; margin-bottom:28px; }
    .error { background:#fdecea; color:#c62828; padding:10px 14px; border-radius:8px; font-size:13px; margin-bottom:16px; }
    .info-box {
      background:#E8F5EE; color:#2D6A4F; padding:14px 16px;
      border-radius:8px; font-size:13px; margin-bottom:16px;
      border-left:4px solid #1B4332;
    }
    .info-box strong { display:block; margin-bottom:6px; font-size:14px; }
    .reset-link-box {
      background:#e8f5e9; color:#1b5e20; padding:16px;
      border-radius:10px; font-size:13px; margin-top:20px;
      border-left:4px solid #2e7d32;
    }
    .reset-link-box strong { display:block; font-size:14px; margin-bottom:8px; }
    .reset-link-box a {
      display:inline-block; margin-top:8px; padding:10px 18px;
      background:#1B4332; color:white; border-radius:7px;
      text-decoration:none; font-size:13px; font-weight:600;
    }
    .reset-link-box a:hover { background:#2D6A4F; }
    .reset-link-box code {
      display:block; margin-top:6px; word-break:break-all;
      font-family:monospace; font-size:12px; opacity:0.8;
    }
    label { display:block; font-size:13px; font-weight:500; color:#444; margin-bottom:5px; margin-top:16px; }
    input {
      width:100%; padding:12px 14px; border:1.5px solid #e0e0e0;
      border-radius:8px; font-size:14px; transition:border-color .2s;
    }
    input:focus { outline:none; border-color:#1B4332; }
    .btn {
      width:100%; padding:13px; background:#1B4332; color:white;
      border:none; border-radius:8px; font-size:15px; font-weight:600;
      cursor:pointer; margin-top:24px; transition:background .2s;
    }
    .btn:hover { background:#2D6A4F; }
    .bottom { text-align:center; margin-top:20px; font-size:13px; color:#888; }
    .bottom a { color:#1B4332; text-decoration:none; font-weight:500; }
    @media(max-width:768px) {
      .left { display:none; }
      .right { padding:40px 24px; }
    }
  </style>
</head>
<body>
  <div class="left">
    <h1>Reset Your Password</h1>
    <p>Enter your registered email address and we'll generate a password reset link for you.</p>
  </div>
  <div class="right">
    <div class="form-panel">
      <a href="/home" style="text-decoration:none"><div class="logo">Keja<span>Hub</span></div></a>
      <h2>Forgot Password</h2>
      <p class="subtitle">Enter your email to receive a reset link</p>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <% if (info) { %>
        <div class="info-box"><%= info %></div>
      <% } %>

      <% if (!resetLink) { %>
        <form method="POST" action="/forgot-password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Email Address</label>
          <input type="email" name="email" placeholder="Enter your registered email" required autofocus>
          <button type="submit" class="btn">Generate Reset Link</button>
        </form>
      <% } %>

      <% if (resetLink) { %>
        <div class="reset-link-box">
          <strong>Your password reset link (dev mode):</strong>
          <p>Click the link below to set a new password. This link expires in 1 hour.</p>
          <a href="<%= resetLink %>">Reset My Password →</a>
          <code><%= resetLink %></code>
        </div>
      <% } %>

      <div class="bottom"><a href="/login">← Back to Sign In</a></div>
    </div>
  </div>
</body>
</html>
