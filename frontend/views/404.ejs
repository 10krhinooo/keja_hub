<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div style="max-width:520px;margin:0 auto;padding:80px 24px;text-align:center">
    <div style="font-family:var(--font-display);font-size:64px;color:var(--leaf);line-height:1">404</div>
    <h1 style="font-family:var(--font-display);font-size:26px;font-weight:400;color:var(--ink);margin:12px 0 10px">
      We couldn't find that page
    </h1>
    <p style="font-size:15px;color:var(--slate);line-height:1.6;margin-bottom:28px">
      The link may be broken, or the listing may have been removed by its landlord.
      Try searching for a house instead, or head back to your dashboard.
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <% if (user && user.role === 'student') { %>
        <a href="/student/search" class="btn">Search Houses</a>
        <a href="/student/dashboard" class="btn" style="background:var(--quiet)">My Dashboard</a>
      <% } else if (user && user.role === 'landlord') { %>
        <a href="/landlord/dashboard" class="btn">My Listings</a>
      <% } else if (user && user.role === 'admin') { %>
        <a href="/admin/dashboard" class="btn">Admin Dashboard</a>
      <% } else { %>
        <a href="/home" class="btn">Go To Homepage</a>
        <a href="/login" class="btn" style="background:var(--quiet)">Log In</a>
      <% } %>
    </div>
  </div>
</body>
</html>
