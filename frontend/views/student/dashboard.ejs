<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home | KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/skeleton.js"></script>
  <style>.search-btn:hover { background: #A86228 !important; }</style>
</head>
<body data-toast-success="<%= (query && query.success === 'welcome') ? 'welcome' : ((query && query.success) || '') %>" data-toast-error="<%= (query && query.error) || '' %>" data-user-name="<%= user.name %>">
  <%- include('../partials/nav-student') %>

  <div style="max-width:1000px;margin:32px auto;padding:0 24px">

    <!-- Welcome banner -->
    <div style="
      background:#1B4332;
      background-image:radial-gradient(circle,rgba(82,183,136,0.14) 1px,transparent 1px);
      background-size:20px 20px;
      padding:36px 32px;border-radius:14px;
      margin-bottom:32px;color:white;
    ">
      <h2 style="font-family:'DM Serif Display',Georgia,serif;font-size:26px;font-weight:400;margin-bottom:6px">
        Welcome, <%= user.name %>
      </h2>
      <p style="opacity:0.72;margin-bottom:22px;font-size:15px">Find affordable student housing near your campus</p>
      <form action="/student/search" method="GET" style="display:flex;gap:8px;max-width:520px">
        <input type="text" name="keyword" placeholder="Search by location, name…"
          style="flex:1;padding:11px 16px;border:1.5px solid rgba(255,255,255,0.2);border-radius:8px;font-size:14px;background:rgba(255,255,255,0.1);color:white;font-family:inherit">
        <button type="submit" class="search-btn"
          style="padding:11px 24px;background:#C97D3A;color:white;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600;font-family:inherit;white-space:nowrap;transition:background .2s">
          Search
        </button>
      </form>
    </div>

    <h3 style="font-family:'DM Serif Display',Georgia,serif;font-size:22px;font-weight:400;color:#1A1A1A;margin-bottom:16px">
      Latest Listings
    </h3>

    <!-- Skeleton shown during load -->
    <div class="skeleton-placeholder" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
      <% for (var s = 0; s < 6; s++) { %>
        <div class="skeleton-card">
          <div class="skeleton-img"></div>
          <div style="padding:16px">
            <div class="skeleton skeleton-line medium" style="margin:0 0 8px"></div>
            <div class="skeleton skeleton-line short" style="margin:0 0 6px"></div>
            <div class="skeleton skeleton-line short" style="width:40%;margin:0 0 8px"></div>
            <div class="skeleton skeleton-line" style="width:50%;margin:0"></div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Real content -->
    <div class="skeleton-content" style="display:none">
      <% if (houses.length === 0) { %>
        <div style="background:white;padding:48px;border-radius:14px;text-align:center;color:#7A9088;border:1px solid #D4E6DB">
          <p style="font-size:18px;margin-bottom:8px;color:#3D4F47">No Approved Listings Yet</p>
          <p>Check back soon or <a href="/student/search" style="color:#1B4332;text-decoration:none;font-weight:500">browse all listings</a>.</p>
        </div>
      <% } else { %>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
          <% for (var i = 0; i < houses.length; i++) { %>
            <% var house = houses[i]; %>
            <a href="/student/house/<%= house.id %>" class="house-card">
              <% if (house.primary_image) { %>
                <img src="<%= house.primary_thumbnail || house.primary_image %>" alt="<%= house.title %>">
              <% } else { %>
                <div class="img-placeholder">No Photo Yet</div>
              <% } %>
              <div class="card-body">
                <h4><%= house.title %></h4>
                <p>📍 <%= house.location %></p>
                <p>🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
                <div class="rent">KES <%= Number(house.rent).toLocaleString() %>/Mo</div>
                <% if (house.avg_rating) { %>
                  <span class="rating">★ <%= Number(house.avg_rating).toFixed(1) %> (<%= house.review_count %> Reviews)</span>
                <% } %>
              </div>
            </a>
          <% } %>
        </div>
      <% } %>
    </div>

  </div>

  <script src="/js/toast-init.js"></script>
</body>
</html>
