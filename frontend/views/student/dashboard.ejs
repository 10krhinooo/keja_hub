<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <h1>KejaHub</h1>
    <div>
      <a href="/student/dashboard">Home</a>
      <a href="/student/search">Search</a>
      <a href="/student/bookings">My Bookings</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <div style="background:linear-gradient(135deg,#1565c0,#0d47a1);padding:40px 32px;border-radius:16px;margin-bottom:32px;text-align:center;color:white">
<h2 style="font-size:28px;font-weight:700;margin-bottom:8px">Welcome, <%= user.name %>!</h2>
      <p style="opacity:0.9;margin-bottom:24px;font-size:15px">Find Affordable Student Housing Near Your Campus</p>
      <form action="/student/search" method="GET" style="display:flex;gap:8px;max-width:560px;margin:0 auto">
        <input type="text" name="keyword" placeholder="Search by location, name..." style="flex:1;padding:12px 16px;border:none;border-radius:8px;font-size:14px">
        <button type="submit" style="padding:12px 24px;background:#ff6f00;color:white;border:none;border-radius:8px;cursor:pointer;font-size:14px;font-weight:600">Search</button>
      </form>
    </div>
    <h3 style="font-size:20px;font-weight:600;color:white;margin-bottom:16px;text-shadow:0 2px 8px rgba(0,0,0,0.3)">Latest Listings</h3>
    <% if (houses.length === 0) { %>
      <div style="background:white;padding:48px;border-radius:16px;text-align:center;color:#999">
        <p style="font-size:18px;margin-bottom:8px">No Approved Listings Yet</p>
        <p>Check back soon!</p>
      </div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
        <% for (var i = 0; i < houses.length; i++) { %>
          <% var house = houses[i]; %>
          <a href="/student/house/<%= house.id %>" class="house-card">
            <% if (house.primary_image) { %>
              <img src="<%= house.primary_image %>" alt="<%= house.title %>">
            <% } else { %>
              <div class="img-placeholder">No Photo Yet</div>
            <% } %>
            <div class="card-body">
              <h4><%= house.title %></h4>
              <p>📍 <%= house.location %></p>
              <p>🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
              <div class="rent">KES <%= Number(house.rent).toLocaleString() %>/Mo</div>
              <% if (house.avg_rating) { %>
                <span class="rating">★ <%= Number(house.avg_rating).toFixed(1) %> (<%= house.review_count %> Reviews)</span>
              <% } %>
            </div>
          </a>
        <% } %>
      </div>
    <% } %>
  </div>
</body>
</html>