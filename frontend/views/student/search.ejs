<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search Houses — KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/skeleton.js"></script>
  <style>
    .search-grid { display:grid; grid-template-columns:2fr 1fr 1fr 1fr 1fr 1fr; gap:12px; align-items:end; }
    @media (max-width:900px) { .search-grid { grid-template-columns:1fr 1fr 1fr; } }
    @media (max-width:600px) { .search-grid { grid-template-columns:1fr 1fr; } }
    @media (max-width:440px) { .search-grid { grid-template-columns:1fr; } }

    .amenity-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:6px; margin-top:4px; }
    .amenity-label {
      display:flex; align-items:center; gap:6px; font-size:13px;
      font-weight:400; margin:0; cursor:pointer; padding:6px 10px;
      border-radius:6px; border:1.5px solid #D4E6DB;
      background:white; transition:all .15s; color:#3D4F47;
    }
    .amenity-label:hover { border-color:#52B788; background:#F0FBF5; }
    .amenity-label input { width:auto; margin:0; }
    .amenity-label input:checked + span { color:#1B4332; font-weight:600; }
    .amenity-label:has(input:checked) { border-color:#1B4332; background:#E8F5EE; }

    .pagination { display:flex; gap:4px; justify-content:center; margin-top:24px; flex-wrap:wrap; }
    .pagination a {
      display:inline-block; padding:7px 13px; border-radius:6px; font-size:13px;
      font-weight:500; text-decoration:none;
      background:white; color:#3D4F47;
      border:1px solid #D4E6DB;
      box-shadow:0 1px 4px rgba(27,67,50,0.06);
      transition:all .15s;
    }
    .pagination a:hover { background:#EEF5F0; border-color:#52B788; }
    .pagination a.pg-active { background:#1B4332; color:white; border-color:#1B4332; }

    .results-bar { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:8px; }

    details summary { cursor:pointer; font-size:13px; font-weight:500; color:#2D6A4F; list-style:none; }
    details summary::after { content:' ▾'; }
    details[open] summary::after { content:' ▴'; }
  </style>
</head>
<body>
  <%- include('../partials/nav-student') %>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">

    <!-- Filter card -->
    <div class="card">
      <form action="/student/search" method="GET">
        <div class="search-grid">
          <div>
            <label>Search</label>
            <input type="text" name="keyword" placeholder="Estate, title, keyword…" value="<%= filters.keyword || '' %>">
          </div>
          <div>
            <label>Location</label>
            <select name="location">
              <option value="">Any Location</option>
              <% if (typeof locations !== 'undefined') { %>
                <% for (var li = 0; li < locations.length; li++) { %>
                  <option value="<%= locations[li] %>" <%= filters.location === locations[li] ? 'selected' : '' %>><%= locations[li] %></option>
                <% } %>
              <% } %>
            </select>
          </div>
          <div>
            <label>Min Rent (KES)</label>
            <input type="number" name="min_rent" placeholder="e.g. 3000" min="0" value="<%= filters.min_rent || '' %>">
          </div>
          <div>
            <label>Max Rent (KES)</label>
            <input type="number" name="max_rent" placeholder="e.g. 20000" min="0" value="<%= filters.max_rent || '' %>">
          </div>
          <div>
            <label>Bedrooms</label>
            <select name="bedrooms">
              <option value="">Any</option>
              <option value="1" <%= filters.bedrooms=='1'?'selected':'' %>>1 Bedroom</option>
              <option value="2" <%= filters.bedrooms=='2'?'selected':'' %>>2 Bedrooms</option>
              <option value="3" <%= filters.bedrooms=='3'?'selected':'' %>>3 Bedrooms</option>
              <option value="4" <%= filters.bedrooms=='4'?'selected':'' %>>4+ Bedrooms</option>
            </select>
          </div>
          <div>
            <label>Bathrooms</label>
            <select name="bathrooms">
              <option value="">Any</option>
              <option value="1" <%= filters.bathrooms=='1'?'selected':'' %>>1 Bathroom</option>
              <option value="2" <%= filters.bathrooms=='2'?'selected':'' %>>2 Bathrooms</option>
              <option value="3" <%= filters.bathrooms=='3'?'selected':'' %>>3+ Bathrooms</option>
            </select>
          </div>
        </div>

        <!-- Amenities (collapsible) -->
        <details style="margin-top:14px" <%= amenities.length > 0 ? 'open' : '' %>>
          <summary>Filter by Amenities <% if (amenities.length > 0) { %>(<%= amenities.length %> selected)<% } %></summary>
          <div class="amenity-grid" style="margin-top:10px">
            <% var allAmenities = ['WiFi','Water','Electricity','Parking','Security','CCTV','Furnished','Kitchen','Balcony']; %>
            <% for (var ai = 0; ai < allAmenities.length; ai++) { %>
              <% var am = allAmenities[ai]; %>
              <label class="amenity-label">
                <input type="checkbox" name="amenities" value="<%= am %>" <%= amenities.indexOf(am) > -1 ? 'checked' : '' %>>
                <span><%= am %></span>
              </label>
            <% } %>
          </div>
        </details>

        <!-- Sort + actions row -->
        <div style="display:flex;gap:8px;align-items:flex-end;margin-top:14px;flex-wrap:wrap">
          <div style="flex:1;min-width:160px">
            <label>Sort By</label>
            <select name="sort">
              <option value="newest"      <%= (filters.sort||'newest')==='newest'     ?'selected':'' %>>Newest First</option>
              <option value="price_asc"   <%= filters.sort==='price_asc'              ?'selected':'' %>>Price: Low → High</option>
              <option value="price_desc"  <%= filters.sort==='price_desc'             ?'selected':'' %>>Price: High → Low</option>
              <option value="rating_desc" <%= filters.sort==='rating_desc'            ?'selected':'' %>>Rating: High → Low</option>
            </select>
          </div>
          <button type="submit" class="btn">Search</button>
          <a href="/student/search" class="btn" style="background:#7A9088">Clear</a>
        </div>
      </form>
    </div>

    <!-- Results bar -->
    <div class="results-bar">
      <h3 style="font-size:17px;font-weight:600;color:#1A1A1A">
        <%= totalCount %> Listing<% if (totalCount !== 1) { %>s<% } %> Found
        <% if (totalPages > 1) { %><span style="font-size:13px;font-weight:400;color:#7A9088"> — Page <%= page %> of <%= totalPages %></span><% } %>
      </h3>
      <% if (amenities.length > 0 || filters.keyword || filters.location || filters.min_rent || filters.max_rent || filters.bedrooms || filters.bathrooms) { %>
        <a href="/student/search" style="font-size:13px;color:#C62828;text-decoration:none;font-weight:500">✕ Clear filters</a>
      <% } %>
    </div>

    <!-- Skeleton -->
    <div class="skeleton-placeholder" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
      <% for (var s = 0; s < 6; s++) { %>
        <div class="skeleton-card">
          <div class="skeleton-img"></div>
          <div style="padding:16px">
            <div class="skeleton skeleton-line medium" style="margin:0 0 8px"></div>
            <div class="skeleton skeleton-line short" style="margin:0 0 6px"></div>
            <div class="skeleton skeleton-line short" style="width:40%;margin:0 0 8px"></div>
            <div class="skeleton skeleton-line" style="width:50%;margin:0"></div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Real content -->
    <div class="skeleton-content" style="display:none">
      <% if (houses.length === 0) { %>
        <div style="background:white;padding:48px;border-radius:14px;text-align:center;color:#7A9088;border:1px solid #D4E6DB">
          <p style="font-size:40px;margin-bottom:12px">🔍</p>
          <p style="font-size:18px;font-weight:600;margin-bottom:8px;color:#3D4F47">No Houses Match Your Search</p>
          <p style="margin-bottom:16px">Try adjusting your filters or clearing the search.</p>
          <a href="/student/search" class="btn">Browse All Listings</a>
        </div>
      <% } else { %>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
          <% for (var i = 0; i < houses.length; i++) { %>
            <% var house = houses[i]; %>
            <a href="/student/house/<%= house.id %>" class="house-card">
              <% if (house.primary_image) { %>
                <img src="<%= house.primary_image %>" alt="<%= house.title %>">
              <% } else { %>
                <div class="img-placeholder">No Photo Yet</div>
              <% } %>
              <div class="card-body">
                <h4><%= house.title %></h4>
                <p>📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
                <p>🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
                <div class="rent">KES <%= Number(house.rent).toLocaleString() %>/Mo</div>
                <% if (house.avg_rating) { %>
                  <span class="rating">★ <%= Number(house.avg_rating).toFixed(1) %> (<%= house.review_count %> Reviews)</span>
                <% } %>
              </div>
            </a>
          <% } %>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <%
            var baseUrl = '/student/search?';
            var qp = [];
            if (filters.keyword)    qp.push('keyword='    + encodeURIComponent(filters.keyword));
            if (filters.location)   qp.push('location='   + encodeURIComponent(filters.location));
            if (filters.min_rent)   qp.push('min_rent='   + filters.min_rent);
            if (filters.max_rent)   qp.push('max_rent='   + filters.max_rent);
            if (filters.bedrooms)   qp.push('bedrooms='   + filters.bedrooms);
            if (filters.bathrooms)  qp.push('bathrooms='  + filters.bathrooms);
            if (filters.sort)       qp.push('sort='       + filters.sort);
            amenities.forEach(function(a){ qp.push('amenities=' + encodeURIComponent(a)); });
            var baseUrl = '/student/search?' + qp.join('&') + (qp.length ? '&' : '');
          %>
          <div class="pagination">
            <% if (page > 1) { %>
              <a href="<%= baseUrl %>page=<%= page-1 %>">‹ Prev</a>
            <% } %>
            <% for (var p = Math.max(1, page-2); p <= Math.min(totalPages, page+2); p++) { %>
              <a href="<%= baseUrl %>page=<%= p %>" class="<%= p===page?'pg-active':'' %>"><%= p %></a>
            <% } %>
            <% if (page < totalPages) { %>
              <a href="<%= baseUrl %>page=<%= page+1 %>">Next ›</a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>

  </div>
</body>
</html>
