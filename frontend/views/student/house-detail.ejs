<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= house.title %> - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/validation.js"></script>
  <script src="/js/skeleton.js"></script>
  <script src="/js/lightbox.js"></script>
</head>
<body data-toast-success="<%= (query && query.success) || '' %>" data-toast-error="<%= (query && query.error) || '' %>">
  <%- include('../partials/nav-student') %>
  <div class="page-container">
    <a href="/student/search" class="back-link">← Back To Search</a>

    <!-- Skeleton for house detail -->
    <div class="skeleton-placeholder">
      <div class="card">
        <div class="skeleton skeleton-line skel-title-lg"></div>
        <div class="skeleton skeleton-line short skel-mb-6"></div>
        <div class="skeleton skeleton-line short skel-mb-6"></div>
        <div class="skeleton skeleton-line skel-price"></div>
        <div class="skel-photo-grid">
          <% for(var si=0;si<3;si++){%><div class="skeleton skel-photo-tile"></div><%}%>
        </div>
        <div class="skel-chip-row">
          <% for(var ai=0;ai<4;ai++){%><div class="skeleton skel-chip"></div><%}%>
        </div>
      </div>
    </div>

    <!-- Real content -->
    <div class="skeleton-content" style="display:none">
      <div class="card">
        <h2 class="detail-title"><%= house.title %></h2>
        <p class="meta-line">📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
        <p class="meta-line">🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
        <% if (avgRating) { %>
          <p class="rating-line">★ <%= avgRating %> Average Rating</p>
        <% } %>
        <div class="price-display--student">KES <%= Number(house.rent).toLocaleString() %>/Month</div>
        <% if (house.description) { %>
          <p class="description-text mt-8"><%= house.description %></p>
        <% } %>
        <% if (amenities.length > 0) { %>
          <p class="section-label mt-20">Amenities</p>
          <div class="chip-row mt-8">
            <% for (var i = 0; i < amenities.length; i++) { %>
              <span class="amenity-chip"><%= amenities[i].name %></span>
            <% } %>
          </div>
        <% } %>
        <% if (images.length > 0) { %>
          <p class="section-label mt-20">Photos</p>
          <div class="photo-grid mt-8">
            <% for (var j = 0; j < images.length; j++) { %>
              <img src="<%= images[j].image_path %>" alt="Photo" class="lb-trigger photo-tile" data-full="<%= images[j].image_path %>">
            <% } %>
          </div>
        <% } %>
      </div>

      <div class="card">
        <h3 class="card-h3">Landlord Contact</h3>
        <div class="info-box">
          <p class="info-line"><strong>Name:</strong> <%= landlord.name %></p>
          <p class="info-line-tight"><strong>Phone:</strong> <%= landlord.phone ? landlord.phone : 'Not provided' %></p>
        </div>
      </div>

      <div class="card">
        <h3 class="card-h3">Send A Request</h3>
        <% if (existingBooking) { %>
          <div class="status-banner">
            <span class="status-icon">✅</span>
            <div>
              <p class="bold-line">
                <%= existingBooking.type.charAt(0).toUpperCase() + existingBooking.type.slice(1) %> request sent
              </p>
              <p class="status-sub">
                Status: <strong><%= existingBooking.status.charAt(0).toUpperCase() + existingBooking.status.slice(1) %></strong>
                <% if (existingBooking.visit_date) { %> &nbsp;·&nbsp; Visit date: <%= existingBooking.visit_date %><% } %>
              </p>
              <% if (existingBooking.status === 'accepted') { %>
                <p class="status-note">Your request was accepted. Contact the landlord to confirm your move-in.</p>
              <% } %>
            </div>
          </div>
        <% } else { %>
          <form action="/student/booking" method="POST" data-validate-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="house_id" value="<%= house.id %>">
            <label>Request Type</label>
            <select name="type" data-required="Please select a request type">
              <option value="viewing">Viewing Request</option>
              <option value="booking">Booking Request</option>
            </select>
            <label>Preferred Visit Date</label>
            <input type="date" name="visit_date" min="<%= new Date().toISOString().split('T')[0] %>" data-required="Please select a visit date">
            <label>Message To Landlord</label>
            <textarea name="message" placeholder="Introduce yourself and ask any questions..." class="textarea-md"></textarea>
            <button type="submit" class="btn mt-16">Send Request</button>
          </form>
        <% } %>
      </div>

      <div class="card">
        <h3 class="card-h3">Reviews (<%= reviews.length %>)</h3>
        <% if (reviews.length === 0) { %>
          <p class="muted-text">No reviews yet. Be the first to review!</p>
        <% } else { %>
          <% for (var k = 0; k < reviews.length; k++) { %>
            <% var review = reviews[k]; %>
            <div class="review-item">
              <p class="review-author"><%= review.student_name %></p>
              <div class="rating-stars">
                <% for (var s = 0; s < review.rating; s++) { %>★<% } %>
              </div>
              <% if (review.comment) { %>
                <p class="review-comment"><%= review.comment %></p>
              <% } %>
            </div>
          <% } %>
        <% } %>
        <div class="divider-section">
          <h3 class="card-h3-sm mb-12">Leave A Review</h3>
          <% if (existingReview) { %>
            <div class="info-box info-box--alt">
              <p class="bold-line">You reviewed this house</p>
              <div class="rating-stars--lg">
                <% for (var r = 0; r < existingReview.rating; r++) { %>★<% } %>
              </div>
              <% if (existingReview.comment) { %>
                <p class="review-comment"><%= existingReview.comment %></p>
              <% } %>
            </div>
          <% } else { %>
            <form action="/student/review" method="POST" data-validate-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="house_id" value="<%= house.id %>">
              <label>Rating</label>
              <select name="rating" data-required="Please select a rating">
                <option value="5">★★★★★ Excellent</option>
                <option value="4">★★★★ Good</option>
                <option value="3">★★★ Average</option>
                <option value="2">★★ Poor</option>
                <option value="1">★ Terrible</option>
              </select>
              <label>Comment</label>
              <textarea name="comment" placeholder="Share your experience..." class="textarea-sm"
                data-required="Please share your experience" data-min-length="5" data-min-length-msg="Comment must be at least 5 characters"></textarea>
              <button type="submit" class="btn mt-16">Submit Review</button>
            </form>
          <% } %>
        </div>
      </div>

      <div class="card">
        <h3 class="card-h3">Report This Listing</h3>
        <form action="/student/report" method="POST" data-validate-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="house_id" value="<%= house.id %>">
          <label>Reason For Reporting</label>
          <textarea name="reason" placeholder="Describe the issue with this listing..." class="textarea-sm"
            data-required="Please describe the issue"
            data-min-length="10" data-min-length-msg="Please provide more detail (at least 10 characters)"></textarea>
          <button type="submit" class="btn btn-outline mt-16">Report Listing</button>
        </form>
      </div>
    </div>
  </div>
  <script src="/js/toast-init.js"></script>
</body>
</html>
