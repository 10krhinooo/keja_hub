<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Listing - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/validation.js"></script>
  <script src="/js/photo-manager.js"></script>
</head>
<body>
  <%- include('../partials/nav-landlord') %>
  <div style="max-width:700px;margin:32px auto;padding:0 24px">
    <a href="/landlord/dashboard" style="display:inline-block;margin-bottom:16px;color:#1B4332;text-decoration:none;font-size:14px;font-weight:500">← Back To Dashboard</a>
    <h2 style="font-size:22px;font-weight:700;color:#1a1a2e;margin-bottom:8px">Add A New Listing</h2>
    <p style="font-size:13px;color:#888;margin-bottom:24px">Your listing will be reviewed by our team before going live, usually within 24 hours.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <div class="card">
      <form method="POST" action="/landlord/add-house" enctype="multipart/form-data" data-validate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Title</label>
        <input type="text" name="title" placeholder="e.g. Cozy 1-Bedroom Near Campus"
          value="<%= values.title || '' %>"
          data-required="Title is required"
          data-min-length="5" data-min-length-msg="Title must be at least 5 characters">
        <label>Description</label>
        <textarea name="description" placeholder="Describe the house..." style="height:100px;resize:vertical"
          data-required="Description is required"
          data-min-length="20" data-min-length-msg="Description must be at least 20 characters"><%= values.description || '' %></textarea>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div>
            <label>Monthly Rent (KES)</label>
            <input type="number" name="rent" placeholder="e.g. 8000" min="1"
              value="<%= values.rent || '' %>"
              data-required="Rent is required"
              data-min-value="1" data-min-value-msg="Rent must be a number greater than 0">
          </div>
          <div>
            <label>Location / Area</label>
            <select id="loc-select" name="location_select">
              <option value="">Select a location…</option>
              <% if (typeof locations !== 'undefined') { %>
                <% for (var li = 0; li < locations.length; li++) { %>
                  <option value="<%= locations[li] %>" <%= values.location_select === locations[li] ? 'selected' : '' %>><%= locations[li] %></option>
                <% } %>
              <% } %>
              <option value="__new__">+ Add new location…</option>
            </select>
            <input type="text" id="loc-new" name="location_new"
              placeholder="Type new neighbourhood (max 60 chars)"
              maxlength="60" style="display:none;margin-top:8px">
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div>
            <label>Estate / Street</label>
            <input type="text" name="estate" placeholder="e.g. Malibu Estate" value="<%= values.estate || '' %>">
          </div>
          <div>
            <label>Bedrooms</label>
            <select name="bedrooms">
              <option value="1">1 Bedroom</option>
              <option value="2">2 Bedrooms</option>
              <option value="3">3 Bedrooms</option>
              <option value="4">4+ Bedrooms</option>
            </select>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
          <div>
            <label>Bathrooms</label>
            <select name="bathrooms">
              <option value="1">1 Bathroom</option>
              <option value="2">2 Bathrooms</option>
              <option value="3">3+ Bathrooms</option>
            </select>
          </div>
        </div>
        <label>Amenities</label>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:4px">
          <%
            var picked = values.amenities === undefined ? []
              : (Array.isArray(values.amenities) ? values.amenities : [values.amenities]);
          %>
          <% for (var ai = 0; ai < amenityOptions.length; ai++) { var am = amenityOptions[ai]; %>
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;margin-top:0;font-weight:400">
              <input type="checkbox" name="amenities" value="<%= am %>" style="width:auto"
                <%= picked.indexOf(am) > -1 ? 'checked' : '' %>>
              <%= am %>
            </label>
          <% } %>
        </div>

        <div data-photo-manager data-max-new="<%= maxImages %>">
          <label style="margin-top:20px">House Photos</label>
          <p style="font-size:12px;color:#888;margin:0 0 8px">
            Up to <%= maxImages %> photos. The first one becomes your cover image. You can change it later from the edit page.
          </p>
          <div class="photo-dropzone" data-photo-dropzone>
            <input type="file" name="images" multiple accept="image/jpeg,image/png,image/webp" data-photo-input>
            <div style="font-size:14px;font-weight:600;color:#1B4332">Drag photos here, or click to browse</div>
            <div class="photo-dropzone-hint">JPEG, PNG, or WebP · up to 5 MB each</div>
            <div class="photo-dropzone-hint" data-photo-counter></div>
            <div class="photo-grid" data-photo-preview></div>
          </div>
        </div>

        <button type="submit" class="btn" style="margin-top:24px;width:100%;padding:13px">Submit Listing For Review</button>
      </form>
    </div>
  </div>
  <script>
    (function () {
      var locSelect = document.getElementById('loc-select');
      var locNew = document.getElementById('loc-new');
      locSelect.addEventListener('change', function () {
        locNew.style.display = locSelect.value === '__new__' ? 'block' : 'none';
        if (locSelect.value === '__new__') locNew.focus();
      });
      document.querySelector('form').addEventListener('submit', function (e) {
        if (locSelect.value === '__new__' && locNew.value.trim() === '') {
          e.preventDefault();
          locNew.style.border = '1.5px solid #c62828';
          locNew.focus();
          locNew.placeholder = 'Please enter a location name';
        }
        if (locSelect.value === '' && locNew.style.display === 'none') {
          e.preventDefault();
          locSelect.style.border = '1.5px solid #c62828';
          locSelect.focus();
        }
      });
    })();
  </script>
</body>
</html>
