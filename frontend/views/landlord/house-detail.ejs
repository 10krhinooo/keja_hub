<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>House Detail - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/dates.js"></script>
  <script src="/js/lightbox.js"></script>
</head>
<body>
  <%- include('../partials/nav-landlord') %>
  <div style="max-width:900px;margin:32px auto;padding:0 24px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
      <a href="/landlord/dashboard" style="color:#1B4332;text-decoration:none;font-size:14px;font-weight:500">← Back To Dashboard</a>
      <a href="/landlord/house/<%= house.id %>/edit" class="btn btn-sm">Edit Listing</a>
    </div>
    <div class="card">
      <h2 style="font-size:24px;font-weight:700;color:#1a1a2e;margin-bottom:8px"><%= house.title %></h2>
      <p style="color:#666;font-size:14px;margin-bottom:4px">📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
      <p style="color:#666;font-size:14px;margin-bottom:4px">🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
      <div style="font-size:26px;color:#C97D3A;font-weight:700;margin:12px 0">KES <%= Number(house.rent).toLocaleString() %>/Month</div>
      <span class="badge badge-<%= house.status %>"><%= house.status.charAt(0).toUpperCase() + house.status.slice(1) %></span>
      <% if (house.status === 'rejected' && house.rejection_reason) { %>
        <p style="font-size:13px;color:#c62828;margin-top:8px;background:#fdecea;padding:10px 14px;border-radius:8px">
          <strong>Rejection reason:</strong> <%= house.rejection_reason %>
        </p>
      <% } else if (house.status === 'pending') { %>
        <p style="font-size:13px;color:#e65100;margin-top:8px">Awaiting admin review. Your listing is not visible to students yet.</p>
      <% } %>
      <% if (house.description) { %>
        <p style="margin-top:12px;color:#555;font-size:14px;line-height:1.7"><%= house.description %></p>
      <% } %>
      <% if (amenities.length > 0) { %>
        <p style="margin-top:20px;font-weight:600;font-size:14px">Amenities</p>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px">
          <% for (var i = 0; i < amenities.length; i++) { %>
            <span style="background:#E8F5EE;color:#1B4332;padding:5px 14px;border-radius:99px;font-size:12px;font-weight:500"><%= amenities[i].name %></span>
          <% } %>
        </div>
      <% } %>
      <% if (images.length > 0) { %>
        <p style="margin-top:20px;font-weight:600;font-size:14px">Photos</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px;margin-top:8px">
          <% for (var j = 0; j < images.length; j++) { %>
            <img src="<%= images[j].image_path %>" alt="Photo" class="lb-trigger" data-full="<%= images[j].image_path %>" style="width:100%;height:160px;object-fit:cover;border-radius:10px">
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="card">
      <h3 style="font-size:18px;font-weight:600;margin-bottom:16px">Booking And Viewing Requests</h3>
      <% if (bookings.length === 0) { %>
        <p style="color:#999;font-size:13px">No Requests Yet</p>
      <% } else { %>
        <div style="overflow-x:auto">
          <table>
            <thead>
              <tr>
                <th>Student</th>
                <th>Type</th>
                <th>Visit Date</th>
                <th>Message</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% for (var k = 0; k < bookings.length; k++) { %>
                <% var b = bookings[k]; %>
                <tr>
                  <td><%= b.student_name %><br><span style="color:#999;font-size:11px"><%= b.student_email %></span></td>
                  <td><%= b.type.charAt(0).toUpperCase() + b.type.slice(1) %></td>
                  <td><span class="date-val"><%= b.visit_date ? b.visit_date : '-' %></span></td>
                  <td><%= b.message ? b.message : '-' %></td>
                  <td><span class="badge badge-<%= b.status %>"><%= b.status.charAt(0).toUpperCase() + b.status.slice(1) %></span></td>
                  <td>
                    <% if (b.status === 'pending') { %>
                      <form method="POST" action="/landlord/booking/<%= b.id %>" style="display:inline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="accepted">
                        <button class="btn btn-success btn-sm">Accept</button>
                      </form>
                      <form method="POST" action="/landlord/booking/<%= b.id %>" style="display:inline;margin-left:4px">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="declined">
                        <button class="btn btn-danger btn-sm">Decline</button>
                      </form>
                    <% } else { %>
                      <span style="color:#999;font-size:13px"><%= b.status.charAt(0).toUpperCase() + b.status.slice(1) %></span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
  <% if (query && query.success) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.success(Toast.msg('<%= query.success %>'));});</script>
  <% } %>
  <% if (query && query.error) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.error(Toast.msg('<%= query.error %>'));});</script>
  <% } %>
</body>
</html>
