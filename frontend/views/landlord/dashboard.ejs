<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landlord Dashboard | KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/skeleton.js"></script>
</head>
<body data-toast-success="<%= (query && query.success === 'welcome') ? 'welcome' : ((query && query.success) || '') %>" data-toast-error="<%= (query && query.error) || '' %>" data-user-name="<%= user.name %>">
  <%- include('../partials/nav-landlord') %>

  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
      <h2 class="page-title" style="margin-bottom:0">Welcome, <%= user.name %></h2>
      <a href="/landlord/add-house" class="btn">+ Add New Listing</a>
    </div>

    <!-- Skeleton -->
    <div class="skeleton-placeholder" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
      <% for (var s = 0; s < 3; s++) { %>
        <div class="skeleton-card">
          <div class="skeleton-img"></div>
          <div style="padding:16px">
            <div class="skeleton skeleton-line medium" style="margin:0 0 8px"></div>
            <div class="skeleton skeleton-line short" style="margin:0 0 6px"></div>
            <div class="skeleton skeleton-line short" style="width:40%;margin:0 0 8px"></div>
            <div class="skeleton skeleton-line" style="width:50%;margin:0"></div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Real content -->
    <div class="skeleton-content" style="display:none">
      <% if (houses.length === 0) { %>
        <div style="background:white;padding:48px;border-radius:14px;text-align:center;color:#7A9088;border:1px solid #D4E6DB">
          <p style="font-size:18px;margin-bottom:8px;color:#3D4F47">No Listings Yet</p>
          <p>Click "+ Add New Listing" to post your first property.</p>
        </div>
      <% } else { %>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px">
          <% for (var i = 0; i < houses.length; i++) { %>
            <% var house = houses[i]; %>
            <div style="background:white;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(27,67,50,0.08);border:1px solid #D4E6DB">
              <% if (house.primary_image) { %>
                <img src="<%= house.primary_thumbnail || house.primary_image %>" alt="House" style="width:100%;height:200px;object-fit:cover">
              <% } else { %>
                <div style="width:100%;height:200px;background:#EEF5F0;display:flex;align-items:center;justify-content:center;color:#7A9088;font-size:13px">No Photo Yet</div>
              <% } %>
              <div style="padding:16px">
                <h3 style="font-size:15px;font-weight:600;color:#1A1A1A;margin-bottom:6px"><%= house.title %></h3>
                <p style="font-size:13px;color:#7A9088;margin-bottom:4px">📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
                <p style="font-size:13px;color:#7A9088;margin-bottom:4px">🛏 <%= house.bedrooms %> Bed &nbsp; 🚿 <%= house.bathrooms %> Bath</p>
                <div style="font-size:18px;color:#C97D3A;font-weight:700;margin:8px 0">KES <%= Number(house.rent).toLocaleString() %>/Mo</div>
                <span class="badge badge-<%= house.status %>"><%= house.status.charAt(0).toUpperCase() + house.status.slice(1) %></span>
                <% if (house.status === 'rejected') { %>
                  <p style="font-size:12px;color:#C62828;margin-top:4px">
                    <% if (house.rejection_reason) { %>Rejected: <%= house.rejection_reason %><% } else { %>Rejected by admin<% } %>
                  </p>
                <% } else if (house.status === 'pending') { %>
                  <p style="font-size:12px;color:#E65100;margin-top:4px">Awaiting admin approval</p>
                <% } %>
                <p style="font-size:12px;color:#7A9088;margin-top:6px"><%= house.booking_count %> Booking Request(s)</p>
                <div style="display:flex;gap:8px;margin-top:12px">
                  <a href="/landlord/house/<%= house.id %>" class="btn btn-sm">View</a>
                  <form method="POST" action="/landlord/house/<%= house.id %>/delete" style="display:inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-danger btn-sm"
                      data-confirm="Delete this listing? All pending booking requests will also be removed.">
                      Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% } %>
        </div>
        <% if (totalPages > 1) { %>
          <div style="display:flex;gap:4px;justify-content:center;margin-top:24px;flex-wrap:wrap">
            <% if (page > 1) { %>
              <a href="/landlord/dashboard?page=<%= page-1 %>" class="btn btn-sm" style="background:white;color:#3D4F47;border:1px solid #D4E6DB">‹ Prev</a>
            <% } %>
            <% for (var p = Math.max(1, page-2); p <= Math.min(totalPages, page+2); p++) { %>
              <a href="/landlord/dashboard?page=<%= p %>" class="btn btn-sm" style="<%= p===page ? 'background:#1B4332;color:white' : 'background:white;color:#3D4F47;border:1px solid #D4E6DB' %>"><%= p %></a>
            <% } %>
            <% if (page < totalPages) { %>
              <a href="/landlord/dashboard?page=<%= page+1 %>" class="btn btn-sm" style="background:white;color:#3D4F47;border:1px solid #D4E6DB">Next ›</a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <script src="/js/toast-init.js"></script>
  <script src="/js/confirm.js"></script>
</body>
</html>
