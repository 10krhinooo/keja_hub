<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Overview | KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/skeleton.js"></script>
  <script src="/js/dates.js"></script>
  <style>
    .charts-row { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
    @media (max-width:700px) { .charts-row { grid-template-columns:1fr; } }

    .chart-card {
      background:white; border-radius:12px; padding:20px 24px;
      box-shadow:0 2px 12px rgba(27,67,50,0.08);
      border:1px solid #D4E6DB;
    }
    .chart-card h3 {
      font-size:11px; font-weight:600; color:#7A9088;
      margin-bottom:14px; text-transform:uppercase; letter-spacing:0.6px;
    }

    .activity-feed {
      background:white; border-radius:12px; padding:20px 24px;
      box-shadow:0 2px 12px rgba(27,67,50,0.08);
      border:1px solid #D4E6DB; margin-bottom:24px;
    }
    .activity-feed h3 {
      font-family:'DM Serif Display',Georgia,serif;
      font-size:18px; font-weight:400; color:#1A1A1A; margin-bottom:16px;
    }

    .activity-item { display:flex; align-items:flex-start; gap:12px; padding:10px 0; border-bottom:1px solid #D4E6DB; }
    .activity-item:last-child { border-bottom:none; }
    .activity-icon { width:32px; height:32px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
    .activity-icon.booking { background:#E8F5E9; }
    .activity-icon.report  { background:#FDECEA; }
    .activity-text { flex:1; }
    .activity-text .actor { font-weight:600; font-size:13px; color:#1A1A1A; }
    .activity-text .detail { font-size:12px; color:#7A9088; margin-top:2px; }
    .activity-time { font-size:11px; color:#B0C4BB; white-space:nowrap; }

    .table-wrap { overflow-x:auto; }
    .skeleton-placeholder .stats-grid-6 { display:grid; grid-template-columns:repeat(6,1fr); gap:16px; margin-bottom:32px; }
    @media (max-width:900px) { .skeleton-placeholder .stats-grid-6 { grid-template-columns:repeat(3,1fr); } }
  </style>
</head>
<body>
  <%- include('../partials/nav-admin') %>
  <div style="max-width:1100px;margin:32px auto;padding:0 24px">

    <!-- Skeleton -->
    <div class="skeleton-placeholder">
      <div class="stats-grid-6" style="margin-bottom:32px">
        <% for(var si=0;si<6;si++){%>
          <div class="skeleton-stat">
            <div class="skeleton-stat-val"></div>
            <div class="skeleton-stat-lbl"></div>
          </div>
        <%}%>
      </div>
    </div>

    <!-- Real content -->
    <div class="skeleton-content" style="display:none">

      <!-- KPI Cards -->
      <div class="stats-grid-6">
        <div class="stat-card">
          <h3><%= stats.students %></h3>
          <p>Total Students</p>
        </div>
        <div class="stat-card">
          <h3 style="color:#2E7D32"><%= stats.landlords %></h3>
          <p>Total Landlords</p>
        </div>
        <div class="stat-card">
          <h3><%= stats.totalHouses %></h3>
          <p>Total Listings</p>
        </div>
        <a href="/admin/listings?filter=pending" class="stat-card" style="text-decoration:none;color:inherit">
          <h3 style="color:<%= stats.pending > 0 ? '#E65100' : '#1B4332' %>"><%= stats.pending %></h3>
          <p>Pending Approval ↗</p>
        </a>
        <a href="/admin/bookings" class="stat-card" style="text-decoration:none;color:inherit">
          <h3><%= stats.activeBookings %></h3>
          <p>Active Bookings ↗</p>
        </a>
        <a href="/admin/reports" class="stat-card" style="text-decoration:none;color:inherit">
          <h3 style="color:<%= stats.openReports > 0 ? '#C62828' : '#1B4332' %>"><%= stats.openReports %></h3>
          <p>Open Reports ↗</p>
        </a>
      </div>

      <!-- SVG Mini Charts -->
      <div class="charts-row">
        <!-- Listings by Status -->
        <div class="chart-card">
          <h3>Listings by Status</h3>
          <%
            var lMax = Math.max(listingsByStatus.approved, listingsByStatus.pending, listingsByStatus.rejected, 1);
            var lBars = [
              ['Approved', listingsByStatus.approved, '#2E7D32'],
              ['Pending',  listingsByStatus.pending,  '#E65100'],
              ['Rejected', listingsByStatus.rejected, '#C62828']
            ];
          %>
          <svg role="img" aria-label="Listings by status bar chart"
               viewBox="0 0 320 100" style="width:100%;height:auto">
            <% for (var bi = 0; bi < lBars.length; bi++) { %>
              <% var lb = lBars[bi]; var lw = Math.round((lb[1]/lMax)*210); %>
              <text x="78" y="<%= 22 + bi*30 %>" text-anchor="end" font-size="11" fill="#7A9088" font-family="Inter,sans-serif"><%= lb[0] %></text>
              <rect x="82" y="<%= 9 + bi*30 %>" width="<%= lw %>" height="16" rx="3" fill="<%= lb[2] %>"/>
              <text x="<%= 86 + lw %>" y="<%= 22 + bi*30 %>" font-size="10" fill="#3D4F47" font-family="Inter,sans-serif"><%= lb[1] %></text>
            <% } %>
          </svg>
        </div>

        <!-- Bookings by Status -->
        <div class="chart-card">
          <h3>Bookings by Status</h3>
          <%
            var bkMax = Math.max(bookingsByStatus.pending, bookingsByStatus.accepted, bookingsByStatus.declined, 1);
            var bkBars = [
              ['Pending',  bookingsByStatus.pending,  '#E65100'],
              ['Accepted', bookingsByStatus.accepted, '#2E7D32'],
              ['Declined', bookingsByStatus.declined, '#C62828']
            ];
          %>
          <svg role="img" aria-label="Bookings by status bar chart"
               viewBox="0 0 320 100" style="width:100%;height:auto">
            <% for (var bki = 0; bki < bkBars.length; bki++) { %>
              <% var bkb = bkBars[bki]; var bkw = Math.round((bkb[1]/bkMax)*210); %>
              <text x="78" y="<%= 22 + bki*30 %>" text-anchor="end" font-size="11" fill="#7A9088" font-family="Inter,sans-serif"><%= bkb[0] %></text>
              <rect x="82" y="<%= 9 + bki*30 %>" width="<%= bkw %>" height="16" rx="3" fill="<%= bkb[2] %>"/>
              <text x="<%= 86 + bkw %>" y="<%= 22 + bki*30 %>" font-size="10" fill="#3D4F47" font-family="Inter,sans-serif"><%= bkb[1] %></text>
            <% } %>
          </svg>
        </div>
      </div>

      <!-- Top Rated Houses -->
      <h2 class="section-heading">Top Rated Houses</h2>
      <div class="table-wrap" style="margin-bottom:24px">
        <table>
          <thead>
            <tr><th>House</th><th>Location</th><th>Avg Rating</th><th>Reviews</th><th>Landlord</th></tr>
          </thead>
          <tbody>
            <% if (topHouses.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;color:#7A9088;padding:24px">No reviewed listings yet</td></tr>
            <% } else { %>
              <% for (var m = 0; m < topHouses.length; m++) { %>
                <% var th = topHouses[m]; %>
                <tr>
                  <td><a href="/admin/house/<%= th.id %>" style="color:#1B4332;text-decoration:none;font-weight:500"><%= th.title %></a></td>
                  <td><%= th.location %></td>
                  <td style="color:#E65100;font-weight:600">★ <%= th.avg_rating %></td>
                  <td><%= th.review_count %></td>
                  <td><%= th.landlord_name %></td>
                </tr>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Recent Activity Feed -->
      <div class="activity-feed">
        <h3>Recent Activity</h3>
        <% if (activityFeed.length === 0) { %>
          <p style="color:#7A9088;font-size:13px">No activity recorded yet.</p>
        <% } else { %>
          <% for (var ai = 0; ai < activityFeed.length; ai++) { %>
            <% var ev = activityFeed[ai]; %>
            <div class="activity-item">
              <div class="activity-icon <%= ev.event_type %>">
                <%= ev.event_type === 'booking' ? '📅' : '🚩' %>
              </div>
              <div class="activity-text">
                <div class="actor"><%= ev.actor %></div>
                <div class="detail"><%= ev.action.charAt(0).toUpperCase() + ev.action.slice(1) %>: <em><%= ev.house_title %></em></div>
              </div>
              <div class="activity-time date-val"><%= ev.ts %></div>
            </div>
          <% } %>
        <% } %>
      </div>

    </div><!-- end skeleton-content -->
  </div>

  <% if (query && query.success === 'welcome') { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.success('Welcome back, ' + <%- JSON.stringify(user.name) %> + '!');});</script>
  <% } else if (query && query.success) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.success(Toast.msg('<%= query.success %>'));});</script>
  <% } %>
  <% if (query && query.error) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.error(Toast.msg('<%= query.error %>'));});</script>
  <% } %>
</body>
</html>
