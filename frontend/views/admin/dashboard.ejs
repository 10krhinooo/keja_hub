<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="admin-nav">
    <h1>KejaHub Admin</h1>
    <div>
      <a href="/admin/dashboard">Listings</a>
      <a href="/admin/users">Users</a>
      <a href="/admin/reports">Reports</a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:32px">
      <div style="background:white;padding:24px;border-radius:16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
        <h3 style="font-size:36px;font-weight:700;color:#1565c0;margin-bottom:4px"><%= stats.users %></h3>
        <p style="font-size:13px;color:#666">Total Users</p>
      </div>
      <div style="background:white;padding:24px;border-radius:16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
        <h3 style="font-size:36px;font-weight:700;color:#1565c0;margin-bottom:4px"><%= stats.houses %></h3>
        <p style="font-size:13px;color:#666">Total Listings</p>
      </div>
      <div style="background:white;padding:24px;border-radius:16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
        <h3 style="font-size:36px;font-weight:700;color:#f57f17;margin-bottom:4px"><%= stats.pending %></h3>
        <p style="font-size:13px;color:#666">Pending Approval</p>
      </div>
      <div style="background:white;padding:24px;border-radius:16px;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,0.06)">
        <h3 style="font-size:36px;font-weight:700;color:#1565c0;margin-bottom:4px"><%= stats.bookings %></h3>
        <p style="font-size:13px;color:#666">Total Bookings</p>
      </div>
    </div>
    <h2 style="font-size:20px;font-weight:600;color:#1a1a2e;margin-bottom:16px">All Listings</h2>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Landlord</th>
          <th>Rent</th>
          <th>Location</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (listings.length === 0) { %>
          <tr><td colspan="6" style="text-align:center;color:#999;padding:24px">No Listings Yet</td></tr>
        <% } else { %>
          <% for (var i = 0; i < listings.length; i++) { %>
            <% var h = listings[i]; %>
            <tr>
              <td><%= h.title %></td>
              <td><%= h.landlord_name %><br><span style="color:#999;font-size:11px"><%= h.landlord_email %></span></td>
              <td>KES <%= Number(h.rent).toLocaleString() %></td>
              <td><%= h.location %></td>
              <td><span class="badge badge-<%= h.status %>"><%= h.status.charAt(0).toUpperCase() + h.status.slice(1) %></span></td>
              <td>
                <% if (h.status === 'pending') { %>
                  <form method="POST" action="/admin/house/<%= h.id %>/approve" style="display:inline">
                    <button class="btn btn-success btn-sm">Approve</button>
                  </form>
                  <form method="POST" action="/admin/house/<%= h.id %>/reject" style="display:inline;margin-left:4px">
                    <button class="btn btn-danger btn-sm">Reject</button>
                  </form>
                <% } else { %>
                  <span style="color:#999;font-size:13px"><%= h.status.charAt(0).toUpperCase() + h.status.slice(1) %></span>
                <% } %>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    </table>
  </div>
</body>
</html>