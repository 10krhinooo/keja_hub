<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/dates.js"></script>
  <style>
    .table-wrap { overflow-x:auto; }
    .filter-tab { display:inline-block; padding:5px 14px; border-radius:6px; font-size:13px; font-weight:500; text-decoration:none; color:#2D6A4F; background:white; border:1.5px solid #D4E6DB; transition:all .15s; margin-right:4px; }
    .filter-tab:hover { background:#EEF5F0; border-color:#52B788; color:#1B4332; }
    .filter-tab.active { background:#1B4332; color:white; border-color:#1B4332; }
    .reason-toggle { background:none; border:none; color:#1B4332; font-size:12px; cursor:pointer; padding:0 0 0 4px; font-family:inherit; text-decoration:underline; }
    .reason-toggle:hover { color:#2D6A4F; }
    .pagination { display:flex; gap:4px; justify-content:center; margin-top:16px; flex-wrap:wrap; }
    .pagination a { display:inline-block; padding:6px 12px; border-radius:6px; font-size:13px; font-weight:500; text-decoration:none; background:white; color:#3D4F47; border:1px solid #D4E6DB; transition:all .15s; }
    .pagination a:hover { background:#EEF5F0; border-color:#52B788; }
    .pagination a.pg-active { background:#1B4332; color:white; border-color:#1B4332; }
  </style>
</head>
<body data-toast-success="<%= (query && query.success) || '' %>">
  <%- include('../partials/nav-admin') %>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:8px">
      <div>
        <h2 style="font-size:20px;font-weight:700;color:#1a1a2e">Reported Listings</h2>
        <p style="font-size:13px;color:#666;margin-top:2px"><%= totalCount %> report(s)</p>
      </div>
      <div>
        <a href="/admin/reports"               class="filter-tab <%= status===''?'active':'' %>">All</a>
        <a href="/admin/reports?status=open"     class="filter-tab <%= status==='open'?'active':'' %>">Open</a>
        <a href="/admin/reports?status=resolved" class="filter-tab <%= status==='resolved'?'active':'' %>">Resolved</a>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>House</th>
            <th>Reported By</th>
            <th>Reason</th>
            <th>Date</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (reports.length === 0) { %>
            <tr>
              <td colspan="6" style="text-align:center;color:#999;padding:32px">No Reports Found</td>
            </tr>
          <% } else { %>
            <% for (var i = 0; i < reports.length; i++) { %>
              <% var r = reports[i]; %>
              <tr>
                <td><a href="/admin/house/<%= r.house_id %>" style="color:#1B4332;text-decoration:none;font-weight:500"><%= r.house_title %></a></td>
                <td><%= r.reported_by_name %></td>
                <td class="reason-cell">
                  <span class="reason-short"><%= r.reason.length > 80 ? r.reason.slice(0, 80) + '…' : r.reason %></span>
                  <% if (r.reason.length > 80) { %>
                    <span class="reason-full" style="display:none"><%= r.reason %></span>
                    <button type="button" class="reason-toggle">Show more</button>
                  <% } %>
                </td>
                <td><span class="date-val"><%= r.created_at %></span></td>
                <td>
                  <span class="badge badge-<%= r.status %>">
                    <%= r.status.charAt(0).toUpperCase() + r.status.slice(1) %>
                  </span>
                </td>
                <td>
                  <% if (r.status === 'open') { %>
                    <form method="POST" action="/admin/reports/<%= r.id %>/resolve">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-success btn-sm">Resolve</button>
                    </form>
                  <% } else { %>
                    <span style="color:#999;font-size:13px">Resolved</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %>
          <a href="/admin/reports?status=<%= status %>&page=<%= page-1 %>">‹ Prev</a>
        <% } %>
        <% for (var p = Math.max(1, page-2); p <= Math.min(totalPages, page+2); p++) { %>
          <a href="/admin/reports?status=<%= status %>&page=<%= p %>" class="<%= p===page?'pg-active':'' %>"><%= p %></a>
        <% } %>
        <% if (page < totalPages) { %>
          <a href="/admin/reports?status=<%= status %>&page=<%= page+1 %>">Next ›</a>
        <% } %>
      </div>
    <% } %>
  </div>
  <script src="/js/toast-init.js"></script>
  <script src="/js/admin-reports.js"></script>
</body>
</html>
