<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Profile - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/validation.js"></script>
</head>
<body data-toast-success="<%= (query && query.success) || '' %>" data-toast-error="<%= (query && query.error) || '' %>">
  <%- include('../partials/nav-admin') %>
  <div style="max-width:680px;margin:32px auto;padding:0 24px">

    <!-- Header card -->
    <div class="card" style="display:flex;align-items:center;gap:20px">
      <%
        var initials = user.name.trim().split(/\s+/).map(function(n){return n[0];}).join('').toUpperCase().slice(0,2);
      %>
      <div class="profile-avatar" style="background:#1a1a2e"><%= initials %></div>
      <div>
        <h2 style="font-size:22px;font-weight:700;color:#1a1a2e;margin-bottom:4px"><%= user.name %></h2>
        <p style="font-size:13px;color:#666;margin-bottom:8px"><%= user.email %></p>
        <span class="badge" style="background:#e8eaf6;color:#3949ab">Admin</span>
      </div>
    </div>

    <!-- Edit profile -->
    <div class="card">
      <h3 style="font-size:17px;font-weight:600;color:#1a1a2e;margin-bottom:20px">Edit Profile</h3>
      <form method="POST" action="/admin/profile" data-validate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Display Name</label>
        <input type="text" name="name" value="<%= user.name %>"
          data-required="Name is required"
          data-min-length="2" data-min-length-msg="Name must be at least 2 characters">
        <label>Email Address</label>
        <input type="email" value="<%= user.email %>" disabled style="background:#f5f7fa;color:#888;cursor:not-allowed">
        <button type="submit" class="btn" style="margin-top:20px">Save Changes</button>
      </form>
    </div>

    <!-- Change password -->
    <div class="card">
      <h3 style="font-size:17px;font-weight:600;color:#1a1a2e;margin-bottom:20px">Change Password</h3>
      <form method="POST" action="/admin/profile/password" data-validate-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Current Password</label>
        <div class="pwd-wrap">
          <input type="password" name="current_password" placeholder="Enter your current password"
            data-required="Current password is required">
          <button type="button" class="pwd-eye" data-toggle-password aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <label>New Password</label>
        <div class="pwd-wrap">
          <input type="password" name="new_password" placeholder="At least 8 characters"
            data-required="New password is required"
            data-min-length="8" data-min-length-msg="Password must be at least 8 characters">
          <button type="button" class="pwd-eye" data-toggle-password aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <label>Confirm New Password</label>
        <div class="pwd-wrap">
          <input type="password" name="confirm_password" placeholder="Repeat new password"
            data-required="Please confirm your new password"
            data-match="new_password" data-match-msg="Passwords do not match">
          <button type="button" class="pwd-eye" data-toggle-password aria-label="Show password"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <button type="submit" class="btn" style="margin-top:20px">Change Password</button>
      </form>
    </div>

  </div>
  <script src="/js/password-toggle.js"></script>
  <script src="/js/toast-init.js"></script>
</body>
</html>
