<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= house.title %> - Admin - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/dates.js"></script>
  <script src="/js/lightbox.js"></script>
</head>
<body data-toast-success="<%= (query && query.success) || '' %>" data-toast-error="<%= (query && query.error) || '' %>">
  <%- include('../partials/nav-admin') %>
  <div class="page-container page-container--wide">
    <a href="/admin/dashboard" class="back-link">← Back To Dashboard</a>

    <!-- Header card -->
    <div class="card">
      <div class="header-row">
        <div>
          <h2 class="detail-title--compact"><%= house.title %></h2>
          <p class="meta-line">📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
          <p class="meta-line mb-8">🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
          <div class="price-display--admin">KES <%= Number(house.rent).toLocaleString() %>/Month</div>
          <span class="badge badge-<%= house.status %>"><%= house.status.charAt(0).toUpperCase() + house.status.slice(1) %></span>
          <% if (avgRating) { %>
            <span class="rating-badge">★ <%= avgRating %></span>
          <% } %>
        </div>
        <!-- Action buttons -->
        <div class="action-col">
          <% if (house.status === 'pending') { %>
            <form method="POST" action="/admin/house/<%= house.id %>/approve">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-success btn-block">✓ Approve Listing</button>
            </form>
            <button type="button" class="btn btn-danger btn-block" data-show-reject-form>✕ Reject Listing</button>
          <% } else if (house.status === 'approved') { %>
            <button type="button" class="btn btn-danger btn-block" data-show-reject-form>Revoke Approval</button>
          <% } %>
          <form method="POST" action="/admin/house/<%= house.id %>/delete"
            data-confirm="Delete this listing permanently? This cannot be undone.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-block btn-muted">🗑 Delete Listing</button>
          </form>
        </div>
      </div>

      <!-- Reject form (hidden by default) -->
      <div id="reject-form" class="reject-form">
        <form method="POST" action="/admin/house/<%= house.id %>/reject">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Rejection Reason (shown to landlord)</label>
          <textarea name="rejection_reason" placeholder="Describe why this listing is being rejected..."><%= house.rejection_reason || '' %></textarea>
          <div class="inline-actions">
            <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
            <button type="button" class="btn btn-sm btn-muted" data-hide-reject-form>Cancel</button>
          </div>
        </form>
      </div>

      <% if (house.status === 'rejected' && house.rejection_reason) { %>
        <div class="alert alert-error mt-12"><strong>Rejection Reason:</strong> <%= house.rejection_reason %></div>
      <% } %>
    </div>

    <!-- Landlord & Details -->
    <div class="detail-grid">
      <div class="card mb-0">
        <h3 class="card-h3-sm mb-12">Landlord Info</h3>
        <p class="info-line"><strong>Name:</strong> <%= house.landlord_name %></p>
        <p class="info-line"><strong>Email:</strong> <a href="mailto:<%= house.landlord_email %>" class="link-forest"><%= house.landlord_email %></a></p>
        <p class="info-line-tight"><strong>Phone:</strong> <%= house.landlord_phone || 'Not provided' %></p>
      </div>
      <div class="card mb-0">
        <h3 class="card-h3-sm mb-12">Listing Stats</h3>
        <p class="info-line"><strong>Total Bookings:</strong> <%= bookings.length %></p>
        <p class="info-line"><strong>Total Reviews:</strong> <%= reviews.length %></p>
        <p class="info-line-tight"><strong>Avg Rating:</strong> <%= avgRating ? '★ ' + avgRating : 'No reviews yet' %></p>
      </div>
    </div>

    <!-- Description, Amenities, Photos -->
    <div class="card">
      <% if (house.description) { %>
        <h3 class="card-h3-sm mb-8">Description</h3>
        <p class="description-text mb-16"><%= house.description %></p>
      <% } %>
      <% if (amenities.length > 0) { %>
        <h3 class="card-h3-sm mb-8">Amenities</h3>
        <div class="chip-row mb-16">
          <% for (var i = 0; i < amenities.length; i++) { %>
            <span class="amenity-chip"><%= amenities[i].name %></span>
          <% } %>
        </div>
      <% } %>
      <% if (images.length > 0) { %>
        <h3 class="card-h3-sm mb-8">Photos (<%= images.length %>)</h3>
        <div class="photo-grid photo-grid--admin">
          <% for (var j = 0; j < images.length; j++) { %>
            <img src="<%= images[j].image_path %>" alt="Photo" class="lb-trigger photo-tile photo-tile--admin" data-full="<%= images[j].image_path %>">
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Booking Requests -->
    <h2 class="section-heading">Booking Requests (<%= bookings.length %>)</h2>
    <div class="table-wrap mb-8">
      <table>
        <thead>
          <tr><th>Student</th><th>Type</th><th>Visit Date</th><th>Message</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% if (bookings.length === 0) { %>
            <tr><td colspan="6" class="table-empty">No booking requests yet</td></tr>
          <% } else { %>
            <% for (var k = 0; k < bookings.length; k++) { %>
              <% var bk = bookings[k]; %>
              <tr>
                <td><%= bk.student_name %><br><span class="subtext"><%= bk.student_email %></span></td>
                <td><%= bk.type.charAt(0).toUpperCase() + bk.type.slice(1) %></td>
                <td><span class="date-val"><%= bk.visit_date || '-' %></span></td>
                <td class="cell-truncate"><%= bk.message || '-' %></td>
                <td><span class="badge badge-<%= bk.status %>"><%= bk.status.charAt(0).toUpperCase() + bk.status.slice(1) %></span></td>
                <td><span class="date-val"><%= bk.created_at %></span></td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Reviews -->
    <h2 class="section-heading">Reviews (<%= reviews.length %>)</h2>
    <div class="table-wrap mb-32">
      <table>
        <thead>
          <tr><th>Student</th><th>Rating</th><th>Comment</th><th>Date</th></tr>
        </thead>
        <tbody>
          <% if (reviews.length === 0) { %>
            <tr><td colspan="4" class="table-empty">No reviews yet</td></tr>
          <% } else { %>
            <% for (var m = 0; m < reviews.length; m++) { %>
              <% var rv = reviews[m]; %>
              <tr>
                <td><%= rv.student_name %></td>
                <td class="rating-inline">
                  <% for (var s = 0; s < rv.rating; s++) { %>★<% } %>
                  <span class="rating-inline-sub"> (<%= rv.rating %>/5)</span>
                </td>
                <td class="cell-comment"><%= rv.comment || '-' %></td>
                <td><span class="date-val"><%= rv.created_at %></span></td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="/js/toast-init.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/admin-house-detail.js"></script>
</body>
</html>
