<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= house.title %> - Admin - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/dates.js"></script>
  <script src="/js/lightbox.js"></script>
  <style>
    .reject-form { display:none; margin-top:10px; }
    .reject-form textarea { width:100%; height:70px; padding:8px; border:1.5px solid #e0e0e0; border-radius:6px; font-size:13px; resize:vertical; font-family:inherit; margin-bottom:6px; }
    .table-wrap { overflow-x:auto; }
    .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px; }
    @media (max-width:600px) { .detail-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <%- include('../partials/nav-admin') %>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <a href="/admin/dashboard" style="display:inline-block;margin-bottom:16px;color:#1B4332;text-decoration:none;font-size:14px;font-weight:500">← Back To Dashboard</a>

    <!-- Header card -->
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:16px">
        <div>
          <h2 style="font-size:22px;font-weight:700;color:#1a1a2e;margin-bottom:6px"><%= house.title %></h2>
          <p style="color:#666;font-size:14px;margin-bottom:4px">📍 <%= house.location %><% if (house.estate) { %>, <%= house.estate %><% } %></p>
          <p style="color:#666;font-size:14px;margin-bottom:8px">🛏 <%= house.bedrooms %> Bedroom(s) &nbsp; 🚿 <%= house.bathrooms %> Bathroom(s)</p>
          <div style="font-size:24px;color:#1B4332;font-weight:700;margin-bottom:8px">KES <%= Number(house.rent).toLocaleString() %>/Month</div>
          <span class="badge badge-<%= house.status %>"><%= house.status.charAt(0).toUpperCase() + house.status.slice(1) %></span>
          <% if (avgRating) { %>
            <span style="margin-left:10px;color:#f57f17;font-size:14px;font-weight:600">★ <%= avgRating %></span>
          <% } %>
        </div>
        <!-- Action buttons -->
        <div style="display:flex;flex-direction:column;gap:8px;min-width:160px">
          <% if (house.status === 'pending') { %>
            <form method="POST" action="/admin/house/<%= house.id %>/approve">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-success" style="width:100%">✓ Approve Listing</button>
            </form>
            <button type="button" class="btn btn-danger" style="width:100%" onclick="document.getElementById('reject-form').style.display='block';this.style.display='none'">✕ Reject Listing</button>
          <% } else if (house.status === 'approved') { %>
            <button type="button" class="btn btn-danger" style="width:100%" onclick="document.getElementById('reject-form').style.display='block';this.style.display='none'">Revoke Approval</button>
          <% } %>
          <form method="POST" action="/admin/house/<%= house.id %>/delete" onsubmit="return confirm('Delete this listing permanently? This cannot be undone.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" style="width:100%;background:#6c757d">🗑 Delete Listing</button>
          </form>
        </div>
      </div>

      <!-- Reject form (hidden by default) -->
      <div id="reject-form" class="reject-form">
        <form method="POST" action="/admin/house/<%= house.id %>/reject">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label>Rejection Reason (shown to landlord)</label>
          <textarea name="rejection_reason" placeholder="Describe why this listing is being rejected..."><%= house.rejection_reason || '' %></textarea>
          <div style="display:flex;gap:8px">
            <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
            <button type="button" class="btn btn-sm" style="background:#6c757d" onclick="document.getElementById('reject-form').style.display='none'">Cancel</button>
          </div>
        </form>
      </div>

      <% if (house.status === 'rejected' && house.rejection_reason) { %>
        <div class="alert alert-error" style="margin-top:12px"><strong>Rejection Reason:</strong> <%= house.rejection_reason %></div>
      <% } %>
    </div>

    <!-- Landlord & Details -->
    <div class="detail-grid">
      <div class="card" style="margin-bottom:0">
        <h3 style="font-size:16px;font-weight:600;margin-bottom:12px">Landlord Info</h3>
        <p style="font-size:14px;color:#444;margin-bottom:6px"><strong>Name:</strong> <%= house.landlord_name %></p>
        <p style="font-size:14px;color:#444;margin-bottom:6px"><strong>Email:</strong> <a href="mailto:<%= house.landlord_email %>" style="color:#1B4332"><%= house.landlord_email %></a></p>
        <p style="font-size:14px;color:#444"><strong>Phone:</strong> <%= house.landlord_phone || 'Not provided' %></p>
      </div>
      <div class="card" style="margin-bottom:0">
        <h3 style="font-size:16px;font-weight:600;margin-bottom:12px">Listing Stats</h3>
        <p style="font-size:14px;color:#444;margin-bottom:6px"><strong>Total Bookings:</strong> <%= bookings.length %></p>
        <p style="font-size:14px;color:#444;margin-bottom:6px"><strong>Total Reviews:</strong> <%= reviews.length %></p>
        <p style="font-size:14px;color:#444"><strong>Avg Rating:</strong> <%= avgRating ? '★ ' + avgRating : 'No reviews yet' %></p>
      </div>
    </div>

    <!-- Description, Amenities, Photos -->
    <div class="card">
      <% if (house.description) { %>
        <h3 style="font-size:16px;font-weight:600;margin-bottom:8px">Description</h3>
        <p style="color:#555;font-size:14px;line-height:1.7;margin-bottom:16px"><%= house.description %></p>
      <% } %>
      <% if (amenities.length > 0) { %>
        <h3 style="font-size:16px;font-weight:600;margin-bottom:8px">Amenities</h3>
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px">
          <% for (var i = 0; i < amenities.length; i++) { %>
            <span style="background:#E8F5EE;color:#1B4332;padding:5px 14px;border-radius:99px;font-size:12px;font-weight:500"><%= amenities[i].name %></span>
          <% } %>
        </div>
      <% } %>
      <% if (images.length > 0) { %>
        <h3 style="font-size:16px;font-weight:600;margin-bottom:8px">Photos (<%= images.length %>)</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px">
          <% for (var j = 0; j < images.length; j++) { %>
            <img src="<%= images[j].image_path %>" alt="Photo" class="lb-trigger" data-full="<%= images[j].image_path %>" style="width:100%;height:140px;object-fit:cover;border-radius:8px">
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Booking Requests -->
    <h2 class="section-heading">Booking Requests (<%= bookings.length %>)</h2>
    <div class="table-wrap" style="margin-bottom:8px">
      <table>
        <thead>
          <tr><th>Student</th><th>Type</th><th>Visit Date</th><th>Message</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% if (bookings.length === 0) { %>
            <tr><td colspan="6" style="text-align:center;color:#999;padding:24px">No booking requests yet</td></tr>
          <% } else { %>
            <% for (var k = 0; k < bookings.length; k++) { %>
              <% var bk = bookings[k]; %>
              <tr>
                <td><%= bk.student_name %><br><span style="color:#999;font-size:11px"><%= bk.student_email %></span></td>
                <td><%= bk.type.charAt(0).toUpperCase() + bk.type.slice(1) %></td>
                <td><span class="date-val"><%= bk.visit_date || '-' %></span></td>
                <td style="max-width:200px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= bk.message || '-' %></td>
                <td><span class="badge badge-<%= bk.status %>"><%= bk.status.charAt(0).toUpperCase() + bk.status.slice(1) %></span></td>
                <td><span class="date-val"><%= bk.created_at %></span></td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Reviews -->
    <h2 class="section-heading">Reviews (<%= reviews.length %>)</h2>
    <div class="table-wrap" style="margin-bottom:32px">
      <table>
        <thead>
          <tr><th>Student</th><th>Rating</th><th>Comment</th><th>Date</th></tr>
        </thead>
        <tbody>
          <% if (reviews.length === 0) { %>
            <tr><td colspan="4" style="text-align:center;color:#999;padding:24px">No reviews yet</td></tr>
          <% } else { %>
            <% for (var m = 0; m < reviews.length; m++) { %>
              <% var rv = reviews[m]; %>
              <tr>
                <td><%= rv.student_name %></td>
                <td style="color:#f57f17;font-weight:600">
                  <% for (var s = 0; s < rv.rating; s++) { %>★<% } %>
                  <span style="color:#666;font-weight:400;font-size:12px"> (<%= rv.rating %>/5)</span>
                </td>
                <td style="max-width:300px"><%= rv.comment || '-' %></td>
                <td><span class="date-val"><%= rv.created_at %></span></td>
              </tr>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
  <% if (query && query.success) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.success(Toast.msg('<%= query.success %>'));});</script>
  <% } %>
  <% if (query && query.error) { %>
  <script>document.addEventListener('DOMContentLoaded',function(){Toast.error(Toast.msg('<%= query.error %>'));});</script>
  <% } %>
</body>
</html>
