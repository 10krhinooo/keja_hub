<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Users - KejaHub</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/toast.js"></script>
  <script src="/js/dates.js"></script>
  <style>
    .table-wrap { overflow-x:auto; }
    .tab-bar { display:flex; gap:0; border-bottom:2px solid #e0e0e0; margin-bottom:20px; }
    .tab-btn { padding:10px 24px; font-size:14px; font-weight:600; cursor:pointer; border:none; background:none; color:#888; border-bottom:3px solid transparent; margin-bottom:-2px; transition:color .15s,border-color .15s; font-family:inherit; }
    .tab-btn.active { color:#1B4332; border-bottom-color:#1B4332; }
    .tab-panel { display:none; }
    .tab-panel.active { display:block; }
  </style>
</head>
<body data-toast-success="<%= (query && query.success) || '' %>" data-toast-error="<%= (query && query.error) || '' %>">
  <%- include('../partials/nav-admin') %>
  <div style="max-width:1000px;margin:32px auto;padding:0 24px">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px;margin-bottom:16px">
      <div>
        <h2 style="font-size:20px;font-weight:700;color:#1a1a2e">Manage Users</h2>
        <p style="font-size:13px;color:#666;margin-top:2px"><%= students.length %> student(s) · <%= landlords.length %> landlord(s)</p>
      </div>
    </div>

    <!-- Server-side keyword search -->
    <form method="GET" action="/admin/users" style="margin-bottom:16px">
      <div style="display:flex;gap:8px;align-items:center">
        <input type="text" name="keyword" value="<%= keyword %>" placeholder="Search by name or email..." style="max-width:320px;margin:0">
        <button type="submit" class="btn btn-sm">Search</button>
        <a href="/admin/users" class="btn btn-sm" style="background:#6c757d">Clear</a>
      </div>
    </form>

    <!-- Tabs -->
    <div class="tab-bar" data-tab-group>
      <button class="tab-btn active" data-tab-target="students">Students (<%= students.length %>)</button>
      <button class="tab-btn"        data-tab-target="landlords">Landlords (<%= landlords.length %>)</button>
    </div>

    <!-- Students tab -->
    <div id="tab-students" class="tab-panel active">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th><th>Action</th></tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr><td colspan="5" style="text-align:center;color:#999;padding:32px">No students found</td></tr>
            <% } else { %>
              <% for (var i = 0; i < students.length; i++) { %>
                <% var u = students[i]; %>
                <tr>
                  <td><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td><span class="date-val"><%= u.created_at %></span></td>
                  <td>
                    <% if (u.is_active) { %>
                      <span style="color:#2e7d32;font-weight:500">Active</span>
                    <% } else { %>
                      <span style="color:#c62828;font-weight:500">Deactivated</span>
                    <% } %>
                  </td>
                  <td>
                    <form method="POST" action="/admin/users/<%= u.id %>/toggle">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% if (u.is_active) { %>
                        <button class="btn btn-danger btn-sm" data-confirm="Deactivate this user?">Deactivate</button>
                      <% } else { %>
                        <button class="btn btn-success btn-sm" data-confirm="Reactivate this user?">Activate</button>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Landlords tab -->
    <div id="tab-landlords" class="tab-panel">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Name</th><th>Email</th><th>Joined</th><th>Status</th><th>Verified</th><th>Action</th></tr>
          </thead>
          <tbody>
            <% if (landlords.length === 0) { %>
              <tr><td colspan="6" style="text-align:center;color:#999;padding:32px">No landlords found</td></tr>
            <% } else { %>
              <% for (var j = 0; j < landlords.length; j++) { %>
                <% var ll = landlords[j]; %>
                <tr>
                  <td><%= ll.name %></td>
                  <td><%= ll.email %></td>
                  <td><span class="date-val"><%= ll.created_at %></span></td>
                  <td>
                    <% if (ll.is_active) { %>
                      <span style="color:#2e7d32;font-weight:500">Active</span>
                    <% } else { %>
                      <span style="color:#c62828;font-weight:500">Deactivated</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (ll.is_verified) { %>
                      <span style="color:#2e7d32;font-weight:500">✓ Verified</span>
                    <% } else { %>
                      <span style="color:#999">Not verified</span>
                    <% } %>
                  </td>
                  <td>
                    <form method="POST" action="/admin/users/<%= ll.id %>/toggle" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% if (ll.is_active) { %>
                        <button class="btn btn-danger btn-sm" data-confirm="Deactivate this user?">Deactivate</button>
                      <% } else { %>
                        <button class="btn btn-success btn-sm" data-confirm="Reactivate this user?">Activate</button>
                      <% } %>
                    </form>
                    <form method="POST" action="/admin/users/<%= ll.id %>/verify" style="display:inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <% if (ll.is_verified) { %>
                        <button class="btn btn-sm" style="background:#6c757d" data-confirm="Remove verified status?">Unverify</button>
                      <% } else { %>
                        <button class="btn btn-success btn-sm" data-confirm="Mark this landlord as verified?">Verify</button>
                      <% } %>
                    </form>
                  </td>
                </tr>
              <% } %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script src="/js/toast-init.js"></script>
  <script src="/js/confirm.js"></script>
  <script src="/js/tabs.js"></script>
</body>
</html>
