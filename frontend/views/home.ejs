<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>KejaHub</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family: 'Segoe UI', sans-serif;
}

body{
    min-height:100vh;
}

.hero{
    height:100vh;
    background:
    linear-gradient(rgba(0,0,0,0.5),
    rgba(0,0,0,0.5)),
    url('/images/homepage.jpeg');
    background-size:cover;
    background-position:center;
    display:flex;
    justify-content:center;
    align-items:center;
}

.content{
    text-align:center;
    color:white;
    max-width:700px;
    padding:20px;
}

.content h1{
    font-size:4rem;
    margin-bottom:20px;
}

.content p{
    font-size:1.2rem;
    margin-bottom:30px;
    line-height:1.6;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
}

.btn{
    text-decoration:none;
    padding:15px 35px;
    border-radius:30px;
    font-size:18px;
    font-weight:bold;
    transition:0.3s;
}

.login{
    background:white;
    color:#2c3e50;
}

.login:hover{
    background:#f1f1f1;
}

.register{
    background:#27ae60;
    color:white;
}

.register:hover{
    background:#219150;
}

.navbar{
    position:absolute;
    top:0;
    width:100%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 50px;
    color:white;
}

.logo{
    font-size:30px;
    font-weight:bold;
}

.nav-links a{
    color:white;
    text-decoration:none;
    margin-left:25px;
    font-size:18px;
}
</style>
</head>

<body>

<div class="hero">

    <div class="navbar">
        <div class="logo">🏠 KejaHub</div>

        <div class="nav-links">
            <a href="/login">Login</a>
            <a href="/register">Register</a>
        </div>
    </div>

    <div class="content">
        <h1>Find Your Perfect Home</h1>

        <p>
            Discover affordable houses, apartments, and rental properties
            across different locations. KejaHub helps you find a place
            you'll love to call home away from home.
        </p>

        <div class="buttons">
            <a href="/login" class="btn login">Login</a>
            <a href="/register" class="btn register">Get Started</a>
        </div>
    </div>

</div>

</body>
</html>