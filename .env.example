# ── Core ──────────────────────────────────────────────────────────────────
PORT=3000

# Signs the session cookie. Use 32+ random characters. Never use the value below.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SESSION_SECRET=change_me_to_32_random_characters

# Password for the admin@kejahub.com account. Only applied when the database is
# first created. Changing it later has no effect on an existing kejahub.db.
ADMIN_PASSWORD=change_me

# Absolute URL used to build links in outgoing email. Must be the public URL in
# production, or reset links will point at localhost.
APP_URL=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────
# Requires a Google account with 2-Step Verification enabled and a 16-character
# App Password (https://myaccount.google.com/apppasswords). A normal account
# password will be rejected. Leave SMTP_PASS blank in development. Password
# reset links are then printed to the console instead of emailed.
SMTP_USER=noreply.kejahub@gmail.com
SMTP_PASS=
SMTP_FROM=KejaHub <noreply.kejahub@gmail.com>

# ── Uploads ───────────────────────────────────────────────────────────────
# STORAGE_DRIVER=local  # default; writes to ./uploads on local disk
# STORAGE_DRIVER=s3     # switches to an S3-compatible bucket, requires the below
# S3_BUCKET=kejahub-uploads
# S3_REGION=us-east-1
# S3_ENDPOINT=          # only for S3-compatible services (R2, Spaces, MinIO); leave blank for AWS
# S3_PUBLIC_URL=        # base URL images are served from, e.g. https://cdn.example.com

# ── Optional ──────────────────────────────────────────────────────────────
# NODE_ENV=production   # enables secure cookies, trust proxy, HSTS; disables seeding
# SEED=true             # force demo data even in production (staging only)
# SEED_PASSWORD=...     # password shared by the seeded demo accounts. Left unset,
#                       # a random one is generated and printed on first run.
# DB_PATH=./backend/kejahub.db
